{
  "name": "deepseek-codex",
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "deepseek-codex": "./bin/deepseek-codex.mjs"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "NODE_OPTIONS=--experimental-vm-modules npx jest --no-cache --config jest.config.cjs --coverage",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules npx jest --no-cache --config jest.config.cjs --coverage --coverage-reporters=text --coverage-reporters=json-summary --coverage-reporters=lcov",
    "coverage:ci": "NODE_OPTIONS=--experimental-vm-modules npx jest --no-cache --config jest.config.cjs --coverage --coverage-reporters=json-summary --coverage-reporters=text --ci",
    "lint": "eslint src/ tests/",
    "format": "prettier --write src/ tests/ bin/"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "eslint": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.2",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
