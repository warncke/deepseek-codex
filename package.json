{
  "name": "deekseek-codex",
  "version": "1.0.0",
  "description": "Interactive AI-assisted system design CLI using DeepSeek API",
  "type": "module",
  "bin": {
    "deekseek-codex": "./bin/deekseek-codex.mjs"
  },
  "files": [
    "bin/",
    "lib/"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write .",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
